# Copie para .env na raiz do projeto e preencha.
#
# O `docker compose` lê .env automaticamente, então basta `docker compose up`
# — sem precisar exportar variável no shell a cada vez.

# Chave gratuita: themoviedb.org -> Settings -> API -> API Key (v3 auth).
# Sem ela a aplicação sobe e o catálogo usa 49 filmes de exemplo locais.
TMDB_API_KEY=
