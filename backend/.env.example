# --- Aplicação ---
DEBUG=true
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Persistência ---
DATABASE_URL=postgresql+psycopg://palco:palco@localhost:5432/palco
REDIS_URL=redis://localhost:6379/0

# --- Sessão ---
# O session_id é um token opaco; não há segredo de assinatura porque o token
# não carrega dado nenhum. Estes valores controlam só o ciclo de vida no Redis.
SESSION_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

# --- Ingresso ---
# TROQUE em produção: um segredo previsível torna o QR forjável.
TICKET_HMAC_SECRET=trocar-em-producao

# --- Regras de negócio ---
RESERVATION_TTL_MINUTES=10
PAYMENT_DECLINE_RATE=0

# --- APIs externas (opcionais: sem elas o catálogo usa fixtures locais) ---
TMDB_API_KEY=
TICKETMASTER_API_KEY=
